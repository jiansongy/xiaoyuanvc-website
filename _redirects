# Cloudflare Pages _redirects rules
# Format: <source> <destination> <status>
# Docs: https://developers.cloudflare.com/pages/configuration/redirects/
# Note: www → apex handled at Cloudflare custom domain level (DNS), not here

# Trailing slash for resource index (case people drop the slash)
/resources /resources/ 301

# preview-v2 子目录如果不慎被 index，重定向到正式资源页
/preview-v2 / 301
/preview-v2/* / 301

# 兼容旧分享链接：如果有人记得 /resources.html（preview 期间路径），跳到资源中心
/resources.html /resources/ 301
/resources/podcast.html /resources/ 301
/resources/podcast /resources/ 301
/resources/:slug.html /resources/:slug 301

# 页面 canonical 统一为无扩展名 URL，保留旧 .html 入口
/student.html /student 301
/dachuang.html /dachuang 301
/teacher.html /teacher 301
/teacher/workshop /teacher 301
/teacher/workshop.html /teacher 301
/teacher/:slug.html /teacher/:slug 301

# 教程站旧根路径兼容：改版后统一挂到 /learn/，避免旧链接命中 VitePress 404
/digital-startup /learn/digital-startup/ 301
/digital-startup/ /learn/digital-startup/ 301
/digital-startup/:slug.html /learn/digital-startup/:slug 301
/digital-startup/* /learn/digital-startup/:splat 301
/crypto-vc /learn/crypto-vc/ 301
/crypto-vc/ /learn/crypto-vc/ 301
/crypto-vc/:slug.html /learn/crypto-vc/:slug 301
/crypto-vc/* /learn/crypto-vc/:splat 301

# /learn/ 是 VitePress 子站根，但落地页本身不展示，访客统一跳到学生中心两张课程卡
# 子路径如 /learn/crypto-vc/* /learn/digital-startup/* 由静态文件服务，不会被这两条匹配
/learn /student#courses 301
/learn/ /student#courses 301

# 数创班单页已从根目录迁入教师中心子树 /teacher/
/shuchuangban.html /teacher/shuchuangban 301
/shuchuangban /teacher/shuchuangban 301

# 媒体报道页 canonical 统一
/about/media.html /about/media 301
