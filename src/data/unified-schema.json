  "entities": {
    "userProfile": {
      "uid": "string",
      "basicInfo": {
        "major": "string",
        "grade": "string",
        "teamSize": "string"
      },
      "projectContext": {
        "track": "string",
        "stage": "string",
        "oneLiner": "string",
        "isHardTech": "boolean",
        "teamSummary": "string"
      },
      "lastActiveTool": "string"
    },
    "toolState": {
      "toolId": "string",
      "draftData": "object",
      "updatedAt": "iso-datetime"
    },
    "toolHistoryEntry": {
      "versionId": "string",
      "inputSnapshot": "object",
      "outputSnapshot": "object",
      "isShared": "boolean",
      "shareId": "string",
      "createdAt": "iso-datetime"
    },
    "actionItem": {
      "actionId": "string",
      "toolId": "string",
      "dimension": "string",
      "status": "待办|已完成",
      "customNote": "string"
    },
    "shareSnapshot": {
      "shareId": "string",
      "toolId": "string",
      "title": "string",
      "payload": "object",
      "createdAt": "iso-datetime"
    },
    "analyticsEvent": {
      "eventId": "string",
      "toolId": "string",
      "eventName": "string",
      "payload": "object",
      "createdAt": "iso-datetime"
    }
  }
